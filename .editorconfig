root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Mirrors the gate: the detekt ktlint wrapper ignores these keys and takes its style from detekt config
# (wrapper default `intellij_idea`; deviations in config/detekt/detekt.yml). Keep both in sync for
# standalone ktlint, the ktlint IDE plugin and editors.
ktlint_code_style = intellij_idea
max_line_length = 120
# Composables are PascalCase by convention (the gate uses detekt's naming.FunctionNaming ignoreAnnotated).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,yml,yaml}]
indent_size = 2
