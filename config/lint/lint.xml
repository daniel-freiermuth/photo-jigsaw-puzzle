<?xml version="1.0" encoding="UTF-8"?>
<!-- Every check is enabled (checkAllWarnings) and warnings are errors. Only deviations are listed. -->
<lint>
  <!--
    "Newer version available" checks depend on the date and on network access, so the same commit
    would pass today and fail tomorrow. Dependency upgrades should be deliberate, reviewed changes.
  -->
  <issue id="AndroidGradlePluginVersion" severity="ignore" />
  <issue id="GradleDependency" severity="ignore" />
  <issue id="NewerVersionAvailable" severity="ignore" />

  <!--
    Fires whenever the Android Gradle plugin's lint learns of a newer API level, so a toolchain upgrade
    would force a targetSdk bump. Raising targetSdk opts into new platform behaviour and needs its own
    deliberate, tested change.
  -->
  <issue id="OldTargetApi" severity="ignore" />

  <!--
    False positive with Kotlin 2 (K2): flags plain member calls such as MutableList.removeAll /
    List.indexOf as conflicting with stdlib extensions that are never imported explicitly.
  -->
  <issue id="MemberExtensionConflict" severity="ignore" />
</lint>
